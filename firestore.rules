rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'admin';
    }

    // Tesoureiro: cuida só de pagamentos, jogos e créditos. NÃO lê os dados
    // pessoais dos jogadores (usa só o cartão público: nome, time e status).
    function isTesoureiro() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'tesoureiro';
    }

    function isFinanceiro() {
      return isAdmin() || isTesoureiro();
    }

    // Organizador: cria/edita jogos e valores e faz o check-in por QR (marca presença
    // e debita os créditos do jogo). NÃO ajusta saldo, não confirma pagamentos e não
    // lê extrato nem dados pessoais.
    function isOrganizador() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'organizador';
    }

    function podeGerirJogos() {
      return isFinanceiro() || isOrganizador();
    }

    // Foto 3x4 guardada como texto (JPEG em base64, ~240x320). Limite de tamanho
    // para ninguém encher o banco; o app reduz a imagem antes de enviar.
    function fotoValida(v) {
      return v == null || (v is string && v.size() < 80000);
    }

    // Logo do time (PNG/JPEG pequeno em base64, ~192px). Limite de tamanho.
    function logoValida(v) {
      return v == null || (v is string && v.size() < 70000);
    }

    // Dados do perfil do time (campos de texto curtos; redes só as conhecidas).
    function textoCurto(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function redesValidas(r) {
      return r == null || (
        r is map &&
        r.keys().hasOnly(['instagram', 'facebook', 'youtube', 'tiktok', 'whatsapp', 'x', 'discord', 'site']) &&
        r.get('instagram', '').size() <= 200 &&
        r.get('facebook', '').size() <= 200 &&
        r.get('youtube', '').size() <= 200 &&
        r.get('tiktok', '').size() <= 200 &&
        r.get('whatsapp', '').size() <= 200 &&
        r.get('x', '').size() <= 200 &&
        r.get('discord', '').size() <= 200 &&
        r.get('site', '').size() <= 200
      );
    }

    function perfilDoTimeValido(d) {
      return logoValida(d.get('logoUrl', null)) &&
        textoCurto(d.get('cidade', null), 80) &&
        textoCurto(d.get('responsavelNome', null), 80) &&
        textoCurto(d.get('dataCriacao', null), 10) &&
        redesValidas(d.get('redes', null));
    }

    // Campos de um jogo (texto curto, link só http/https, vagas inteiras).
    function jogoValido(d) {
      return textoCurto(d.get('local', null), 120) &&
        textoCurto(d.get('descricao', null), 1000) &&
        textoCurto(d.get('horario', null), 5) &&
        (d.get('localLink', null) == null ||
          (d.localLink is string && d.localLink.size() <= 300 && d.localLink.matches('^https?://.*'))) &&
        (d.get('vagas', null) == null || (d.vagas is number && d.vagas >= 0 && d.vagas <= 1000));
    }

    function isRepresentativeOfTeam(timeId) {
      return isSignedIn() && timeId != null &&
        get(/databases/$(database)/documents/teams/$(timeId)).data.representanteUid == request.auth.uid;
    }

    // Perfis dos jogadores. Só o próprio jogador ou um admin pode ler/editar
    // livremente. Um representante de time pode APENAS aprovar/recusar a
    // entrada de um jogador no seu time (campo timeAprovado), nada mais.
    match /players/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Cadastro novo: sempre jogador, inadimplente, sem vencimento e sem time aprovado.
      allow create: if isOwner(uid) &&
        request.resource.data.role == 'player' &&
        request.resource.data.status == 'inadimplente' &&
        request.resource.data.vencimento == null &&
        request.resource.data.timeAprovado == false &&
        request.resource.data.get('aceiteTermosEm', request.time) == request.time &&
        fotoValida(request.resource.data.get('fotoUrl', null));

      // O próprio jogador NÃO pode mexer em papel, status, vencimento, e-mail
      // nem se aprovar em um time; isso é só do admin/representante.
      // Cargos: o app NUNCA cria nem remove um admin (isso é só no console do
      // Firebase). O admin delega os demais cargos, mas não mexe no de outro admin.
      allow update: if (isAdmin() && (
        request.resource.data.role == resource.data.role ||
        (request.resource.data.role != 'admin' && resource.data.role != 'admin')
      )) || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'cargoAlteradoPor', 'cargoAlteradoEm', 'status', 'vencimento', 'ultimoPagamento', 'uid', 'email']) &&
        fotoValida(request.resource.data.get('fotoUrl', null)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aceiteTermosEm']) ||
          request.resource.data.aceiteTermosEm == request.time) &&
        (request.resource.data.timeAprovado == resource.data.timeAprovado ||
         request.resource.data.timeAprovado == false)
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeAprovado', 'atualizadoEm']) &&
        isRepresentativeOfTeam(resource.data.timeId)
      ) || (
        // Tesoureiro: só ao confirmar um pagamento. Só pode mover o vencimento
        // para frente e marcar "pago" (nunca reativar um inativo nem rebaixar).
        isTesoureiro() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'vencimento', 'ultimoPagamento', 'atualizadoEm']) &&
        (request.resource.data.status == resource.data.status ||
         (request.resource.data.status == 'pago' && resource.data.status != 'inativo')) &&
        request.resource.data.vencimento >
          (resource.data.vencimento == null ? 0 : resource.data.vencimento)
      );

      allow delete: if false;
    }

    // Espelho público e mínimo (sem endereço/contato de emergência/condições
    // médicas), lido sem login pela página de verificação via QR code.
    // "get" é público (a página do QR abre sem login); listar a coleção inteira só logado.
    match /publicCards/{uid} {
      allow get: if true;
      allow list: if isSignedIn();

      allow write: if isSignedIn() &&
        fotoValida(request.resource.data.get('fotoUrl', null)) &&
        request.resource.data.get('timeId', null) ==
          (get(/databases/$(database)/documents/players/$(uid)).data.get('timeAprovado', false) == true
            ? get(/databases/$(database)/documents/players/$(uid)).data.get('timeId', null) : null) &&
        request.resource.data.status == get(/databases/$(database)/documents/players/$(uid)).data.status &&
        request.resource.data.vencimento == get(/databases/$(database)/documents/players/$(uid)).data.vencimento && (
          isOwner(uid) ||
          isAdmin() ||
          isRepresentativeOfTeam(get(/databases/$(database)/documents/players/$(uid)).data.timeId) ||
          (isTesoureiro() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'vencimento', 'atualizadoEm']))
        );
    }

    // Times: qualquer associado logado pode ver a lista (para escolher seu
    // time). Só admin cria times e define o representante.
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && perfilDoTimeValido(request.resource.data);
      // O admin edita tudo; o representante só edita o perfil do próprio time
      // (logo, cidade, responsável, data de criação e redes), nunca o nome nem o representante.
      allow update: if (isAdmin() && perfilDoTimeValido(request.resource.data)) || (
        isRepresentativeOfTeam(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['logoUrl', 'cidade', 'responsavelNome', 'dataCriacao', 'redes']) &&
        perfilDoTimeValido(request.resource.data)
      );
      allow delete: if isAdmin();
    }

    // Pedidos de entrada em time: o próprio jogador cria o pedido; o
    // representante do time ou um admin pode ler e resolver (aprovar/recusar).
    match /teamJoinRequests/{requestId} {
      allow read: if isAdmin() ||
        resource.data.jogadorUid == request.auth.uid ||
        isRepresentativeOfTeam(resource.data.timeId);

      allow create: if isSignedIn() && request.resource.data.jogadorUid == request.auth.uid;

      allow update: if isAdmin() || isRepresentativeOfTeam(resource.data.timeId);

      allow delete: if false;
    }

    // Chave Pix e valor da mensalidade: todos leem, só admin altera (o
    // tesoureiro não troca a chave, para ninguém desviar os pagamentos).
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cobranças Pix: o jogador só cria a própria, sempre como "pendente";
    // admin e tesoureiro confirmam (isso é o que libera o status "adimplente").
    match /payments/{paymentId} {
      allow read: if isFinanceiro() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pendente';
      allow update: if isFinanceiro();
      allow delete: if false;
    }

    // Carteira de créditos de jogo (R$ 1 = 2 créditos). Quem credita é só o admin
    // ou o tesoureiro (ao confirmar um pagamento ou ajustar). O jogador NUNCA
    // altera o próprio saldo. O organizador só consegue DEBITAR, e apenas no
    // check-in: o saldo cai exatamente o custo do jogo e, no mesmo lote, a
    // inscrição desse jogador passa de "ativa" para "presente" (getAfter).
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isFinanceiro() || isOrganizador();

      allow create: if isFinanceiro() || (
        isOwner(uid) &&
        request.resource.data.creditos == 0 &&
        request.resource.data.ultimoJogoId == null
      );

      allow update: if isFinanceiro() || (
        isOrganizador() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['creditos', 'ultimoJogoId', 'atualizadoEm']) &&
        request.resource.data.ultimoJogoId is string &&
        request.resource.data.creditos ==
          resource.data.creditos -
          get(/databases/$(database)/documents/games/$(request.resource.data.ultimoJogoId)).data.custoCreditos &&
        request.resource.data.creditos >= 0 &&
        get(/databases/$(database)/documents/participations/$(request.resource.data.ultimoJogoId + '_' + uid)).data.status == 'ativa' &&
        getAfter(/databases/$(database)/documents/participations/$(request.resource.data.ultimoJogoId + '_' + uid)).data.status == 'presente' &&
        getAfter(/databases/$(database)/documents/participations/$(request.resource.data.ultimoJogoId + '_' + uid)).data.pagoCom == 'creditos'
      );

      allow delete: if false;
    }

    // Jogos: admin, tesoureiro e organizador criam e editam (inclusive valores e vagas).
    // O jogador só mexe nos CONTADORES do jogo (inscritos/espera), e só junto com a
    // própria inscrição, de um em um e respeitando o limite de vagas. Assim ninguém
    // passa do limite, mesmo sem servidor.
    match /games/{gameId} {
      function minhaPart() {
        return /databases/$(database)/documents/participations/$(gameId + '_' + request.auth.uid);
      }

      function entraNoJogo() {
        return resource.data.status == 'aberto' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscritos']) &&
          request.resource.data.inscritos == resource.data.get('inscritos', 0) + 1 &&
          (resource.data.get('vagas', null) == null || request.resource.data.inscritos <= resource.data.vagas) &&
          !exists(minhaPart()) && existsAfter(minhaPart()) &&
          getAfter(minhaPart()).data.status == 'ativa';
      }

      function entraNaEspera() {
        return resource.data.status == 'aberto' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['espera']) &&
          request.resource.data.espera == resource.data.get('espera', 0) + 1 &&
          resource.data.get('vagas', null) != null &&
          resource.data.get('inscritos', 0) >= resource.data.vagas &&
          !exists(minhaPart()) && existsAfter(minhaPart()) &&
          getAfter(minhaPart()).data.status == 'espera';
      }

      function saiDoJogo() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscritos']) &&
          request.resource.data.inscritos == resource.data.get('inscritos', 0) - 1 &&
          request.resource.data.inscritos >= 0 &&
          exists(minhaPart()) && !existsAfter(minhaPart()) &&
          get(minhaPart()).data.status == 'ativa';
      }

      function saiDaEspera() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['espera']) &&
          request.resource.data.espera == resource.data.get('espera', 0) - 1 &&
          request.resource.data.espera >= 0 &&
          exists(minhaPart()) && !existsAfter(minhaPart()) &&
          get(minhaPart()).data.status == 'espera';
      }

      allow read: if isSignedIn();
      allow create: if podeGerirJogos() && jogoValido(request.resource.data);
      allow update: if (podeGerirJogos() && jogoValido(request.resource.data)) || (
        isSignedIn() && (entraNoJogo() || entraNaEspera() || saiDoJogo() || saiDaEspera())
      );
      allow delete: if isAdmin();
    }

    // Inscrições em jogos. O id é sempre "<jogo>_<uid>" (uma por jogador).
    // O jogador se inscreve sozinho ("ativa", ou "espera" se lotado; nada cobrado) e
    // pode desistir enquanto não houver check-in; cada entrada/saída exige o ajuste do
    // contador do jogo no mesmo lote (getAfter). A cobrança e a presença são feitas
    // pela organização no check-in (ver wallets acima).
    match /participations/{pid} {
      allow read: if podeGerirJogos() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isFinanceiro() || (
        isSignedIn() &&
        request.resource.data.keys().hasOnly(['gameId', 'gameNome', 'uid', 'jogadorNome', 'pagoCom', 'creditosDebitados', 'status', 'criadoEm']) &&
        request.resource.data.uid == request.auth.uid &&
        pid == request.resource.data.gameId + '_' + request.auth.uid &&
        request.resource.data.pagoCom == 'pendente' &&
        request.resource.data.creditosDebitados == 0 &&
        get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.status == 'aberto' &&
        (
          (request.resource.data.status == 'ativa' &&
            (get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('vagas', null) == null ||
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('inscritos', 0) <
                get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.vagas) &&
            getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('inscritos', 0) ==
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('inscritos', 0) + 1) ||
          (request.resource.data.status == 'espera' &&
            get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('vagas', null) != null &&
            get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('inscritos', 0) >=
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.vagas &&
            getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('espera', 0) ==
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.get('espera', 0) + 1)
        )
      );

      // Admin/tesoureiro: qualquer ajuste. Organizador: o check-in (ativa -> presente),
      // em dinheiro ou com o débito correspondente, e chamar alguém da lista de espera.
      allow update: if isFinanceiro() || (
        isOrganizador() &&
        resource.data.status == 'ativa' &&
        request.resource.data.status == 'presente' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'pagoCom', 'creditosDebitados', 'presenteEm', 'checkInPor', 'checkInPorNome']) &&
        request.resource.data.checkInPor == request.auth.uid &&
        (
          (request.resource.data.pagoCom == 'dinheiro' && request.resource.data.creditosDebitados == 0) ||
          (
            request.resource.data.pagoCom == 'creditos' &&
            request.resource.data.creditosDebitados ==
              get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.custoCreditos &&
            getAfter(/databases/$(database)/documents/wallets/$(resource.data.uid)).data.ultimoJogoId == resource.data.gameId &&
            getAfter(/databases/$(database)/documents/wallets/$(resource.data.uid)).data.creditos ==
              get(/databases/$(database)/documents/wallets/$(resource.data.uid)).data.creditos -
              request.resource.data.creditosDebitados
          )
        )
      ) || (
        isOrganizador() &&
        resource.data.status == 'espera' &&
        request.resource.data.status == 'ativa' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );

      allow delete: if isFinanceiro() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        resource.data.pagoCom == 'pendente' &&
        (
          (resource.data.status == 'ativa' &&
            getAfter(/databases/$(database)/documents/games/$(resource.data.gameId)).data.get('inscritos', 0) ==
              get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.get('inscritos', 0) - 1) ||
          (resource.data.status == 'espera' &&
            getAfter(/databases/$(database)/documents/games/$(resource.data.gameId)).data.get('espera', 0) ==
              get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.get('espera', 0) - 1)
        )
      );
    }

    // Extrato de créditos: livro-razão imutável (ninguém edita nem apaga, nem o
    // admin). Admin e tesoureiro criam qualquer lançamento. O organizador só
    // cria o lançamento do check-in, e só se o saldo do jogador caiu exatamente
    // aquele valor no mesmo lote. O jogador não escreve no extrato.
    match /ledger/{lid} {
      allow read: if isFinanceiro() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isFinanceiro() || (
        isOrganizador() &&
        request.resource.data.tipo == 'jogo' &&
        request.resource.data.refId is string &&
        request.resource.data.porUid == request.auth.uid &&
        lid == 'checkin_' + request.resource.data.refId + '_' + request.resource.data.uid &&
        request.resource.data.creditos ==
          -get(/databases/$(database)/documents/games/$(request.resource.data.refId)).data.custoCreditos &&
        getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.uid)).data.ultimoJogoId == request.resource.data.refId &&
        getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.uid)).data.creditos ==
          get(/databases/$(database)/documents/wallets/$(request.resource.data.uid)).data.creditos + request.resource.data.creditos &&
        request.resource.data.saldoApos ==
          getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.uid)).data.creditos &&
        getAfter(/databases/$(database)/documents/participations/$(request.resource.data.refId + '_' + request.resource.data.uid)).data.status == 'presente'
      );

      allow update, delete: if false;
    }

    // Contato de cobrança: espelho do celular do jogador. Só o próprio jogador grava;
    // só ele e a tesouraria leem (para o botão "Cobrar no WhatsApp").
    match /contatos/{uid} {
      allow read: if isOwner(uid) || isFinanceiro();
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['celular', 'atualizadoEm']) &&
        request.resource.data.celular is string &&
        request.resource.data.celular.size() <= 20;
      allow delete: if false;
    }

    // Registro de quando cada associado foi cobrado (tesouraria).
    match /cobrancas/{uid} {
      allow read: if isFinanceiro();
      allow create, update: if isFinanceiro() &&
        request.resource.data.keys().hasOnly(['ultimaEm', 'porUid', 'porNome']) &&
        request.resource.data.porUid == request.auth.uid;
      allow delete: if false;
    }

    // Mural de avisos: admin, tesoureiro e organizador publicam; todos os logados leem.
    match /avisos/{avisoId} {
      allow read: if isSignedIn();
      allow create: if (isFinanceiro() || isOrganizador()) &&
        request.resource.data.keys().hasOnly(['titulo', 'texto', 'fixado', 'autorUid', 'autorNome', 'criadoEm']) &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.titulo is string && request.resource.data.titulo.size() <= 100 &&
        request.resource.data.texto is string && request.resource.data.texto.size() <= 1000 &&
        request.resource.data.fixado is bool;
      allow update: if (isFinanceiro() || isOrganizador()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixado']);
      allow delete: if isFinanceiro() || isOrganizador();
    }

    // Fila de e-mails consumida pela extensão "Trigger Email" (Firebase
    // Extensions). O backend da extensão usa Admin SDK e ignora estas regras;
    // aqui só liberamos a criação pelo cliente.
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }
  }
}
